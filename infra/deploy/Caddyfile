puriy.sofietorch.dev {
	# Redirect bare prefixes to trailing-slash so relative URLs resolve.
	# Use exact-match (=) so we don't redirect /marimo/foo → /marimo/foo/.
	@bare_grafana path =/grafana
	redir @bare_grafana /grafana/ permanent
	@bare_marimo path =/marimo
	redir @bare_marimo /marimo/ permanent
	@bare_valhalla path =/valhalla
	redir @bare_valhalla /valhalla/ permanent

	# API
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy server:8000
	}

	# Valhalla routing engine
	handle /valhalla/* {
		uri strip_prefix /valhalla
		reverse_proxy valhalla:8002
	}

	# Grafana dashboards
	handle /grafana/* {
		reverse_proxy grafana:3000
	}

	# Marimo notebooks
	handle /marimo/* {
		uri strip_prefix /marimo
		reverse_proxy marimo:2727
	}

	# Project landing page (replace with a static site later)
	handle {
		respond "Puriy - Crowdsourced transit route reconstruction for Cochabamba" 200
	}
}
